# Dockerfile for the rlp-import image.
#
# Builds from cmd/rlp-import ALONE. That directory is its own stdlib-only Go
# module, so this build needs no module download and no network — and, unlike
# the previous version of this file, it does not try to build a package that
# lives outside the root module.
#
# Build:
#   docker build -f Dockerfile.rlp-import -t ghcr.io/luxfi/rlp-import:vX.Y.Z .
FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY cmd/rlp-import/ ./

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH}
RUN go build -trimpath -ldflags="-s -w" -o /out/rlp-import .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/rlp-import /usr/local/bin/rlp-import
ENTRYPOINT ["/usr/local/bin/rlp-import"]
