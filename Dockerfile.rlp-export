# Dockerfile for the rlp-export image.
#
# Builds from cmd/rlp-export ALONE. That directory is its own stdlib-only Go
# module, so this build needs no module download and no network — and, unlike
# the previous version of this file, it does not try to build a package that
# lives outside the root module.
#
# Build:
#   docker build -f Dockerfile.rlp-export -t ghcr.io/luxfi/rlp-export:vX.Y.Z .
FROM golang:1.26-alpine AS builder

WORKDIR /src
COPY cmd/rlp-export/ ./

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH}
RUN go build -trimpath -ldflags="-s -w" -o /out/rlp-export .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
COPY --from=builder /out/rlp-export /usr/local/bin/rlp-export
ENTRYPOINT ["/usr/local/bin/rlp-export"]
